<html>
<head>
<style>
*{margin:0;padding:0;}
body{background:#111;text-align:center;font-family:Arial;color:white;overflow:hidden;}
#ui{padding:10px;}
#score{font-size:20px;color:#FFD700;}
#result{font-size:18px;color:red;font-weight:bold;min-height:25px;}
#controls{padding:10px;}
.btn{padding:10px 20px;font-size:16px;border:none;border-radius:10px;cursor:pointer;margin:5px;}
</style>
</head>
<body>

<div id="ui">
<div id="score">🏆 Score: 0</div>
<div id="result"></div>
</div>

<canvas id="game"></canvas>

<div id="controls">
<button class="btn" onclick="moveLeft()" style="background:#FFD700;color:black;">◀</button>
<button class="btn" onclick="startGame()" style="background:lime;color:black;">START</button>
<button class="btn" onclick="moveRight()" style="background:#FFD700;color:black;">▶</button>
</div>

<script>
var canvas = document.getElementById('game');
var ctx = canvas.getContext('2d');
canvas.width = window.innerWidth;
canvas.height = window.innerHeight - 140;

var W = canvas.width;
var H = canvas.height;

var score = 0;
var speed = 3;
var running = false;
var playerX = W/2;
var obstacles = [];
var lines = [];
var frameCount = 0;

// Road lines
for(var i=0; i<10; i++){
  lines.push({y: i * (H/5)});
}

function moveLeft(){
  if(playerX > W*0.25) playerX -= W*0.2;
}
function moveRight(){
  if(playerX < W*0.75) playerX += W*0.2;
}

function startGame(){
  score=0; speed=3; running=true;
  playerX=W/2; obstacles=[];
  document.getElementById('result').innerHTML='';
  document.getElementById('score').innerHTML='🏆 Score: 0';
  gameLoop();
}

function draw3DCar(x, y, w, h, color, isPlayer){
  // Car shadow
  ctx.fillStyle='rgba(0,0,0,0.3)';
  ctx.ellipse(x, y+h*0.6, w*0.5, h*0.1, 0, 0, Math.PI*2);
  ctx.fill();

  // Car body
  ctx.fillStyle=color;
  ctx.beginPath();
  ctx.roundRect(x-w/2, y, w, h*0.6, 5);
  ctx.fill();

  // Car top
  ctx.fillStyle=isPlayer?'#cc0000':'#0000cc';
  ctx.beginPath();
  ctx.roundRect(x-w*0.35, y-h*0.3, w*0.7, h*0.35, 5);
  ctx.fill();

  // Windshield
  ctx.fillStyle='rgba(150,220,255,0.7)';
  ctx.beginPath();
  ctx.roundRect(x-w*0.28, y-h*0.28, w*0.56, h*0.25, 3);
  ctx.fill();

  // Wheels
  ctx.fillStyle='#111';
  ctx.beginPath();ctx.ellipse(x-w*0.42, y+h*0.45, w*0.15, h*0.12, 0, 0, Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(x+w*0.42, y+h*0.45, w*0.15, h*0.12, 0, 0, Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(x-w*0.42, y+h*0.1, w*0.15, h*0.12, 0, 0, Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(x+w*0.42, y+h*0.1, w*0.15, h*0.12, 0, 0, Math.PI*2);ctx.fill();

  // Headlights
  ctx.fillStyle=isPlayer?'yellow':'red';
  ctx.beginPath();ctx.ellipse(x-w*0.3, y+h*0.55, w*0.1, h*0.06, 0, 0, Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(x+w*0.3, y+h*0.55, w*0.1, h*0.06, 0, 0, Math.PI*2);ctx.fill();
}

function gameLoop(){
  if(!running) return;
  ctx.clearRect(0,0,W,H);

  // Sky gradient
  var sky = ctx.createLinearGradient(0,0,0,H*0.4);
  sky.addColorStop(0,'#0a0a2e');
  sky.addColorStop(1,'#1a1a4e');
  ctx.fillStyle=sky;
  ctx.fillRect(0,0,W,H*0.4);

  // Ground
  var ground = ctx.createLinearGradient(0,H*0.4,0,H);
  ground.addColorStop(0,'#1a1a1a');
  ground.addColorStop(1,'#333');
  ctx.fillStyle=ground;
  ctx.fillRect(0,H*0.4,W,H*0.6);

  // Road perspective
  ctx.fillStyle='#222';
  ctx.beginPath();
  ctx.moveTo(W*0.3,H*0.4);
  ctx.lineTo(W*0.7,H*0.4);
  ctx.lineTo(W,H);
  ctx.lineTo(0,H);
  ctx.fill();

  // Road lines moving
  lines.forEach(function(l){
    l.y += speed;
    if(l.y > H) l.y = H*0.4;
    var progress = (l.y - H*0.4) / (H - H*0.4);
    var lineW = W*0.4*progress;
    var lineX = W/2 - lineW/2;
    ctx.fillStyle='rgba(255,255,255,0.5)';
    ctx.fillRect(lineX + lineW*0.48, l.y, lineW*0.04, 15*progress);
  });

  // Side lines
  ctx.strokeStyle='rgba(255,200,0,0.6)';
  ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(W*0.3,H*0.4);ctx.lineTo(0,H);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W*0.7,H*0.4);ctx.lineTo(W,H);ctx.stroke();

  // Spawn obstacles
  frameCount++;
  if(frameCount % 80 == 0){
    var lanes = [W*0.25, W*0.5, W*0.75];
    obstacles.push({
      x: lanes[Math.floor(Math.random()*3)],
      y: H*0.4,
      color: ['#0044ff','#00aa00','#ff6600'][Math.floor(Math.random()*3)]
    });
  }

  // Draw obstacles
  obstacles.forEach(function(ob, i){
    ob.y += speed;
    var size = (ob.y - H*0.4) / (H - H*0.4);
    var w = 60*size;
    var h = 90*size;
    draw3DCar(ob.x, ob.y, w, h, ob.color, false);

    // Collision
    if(ob.y > H*0.75){
      var carW = 50;
      if(Math.abs(ob.x - playerX) < carW){
        running = false;
        document.getElementById('result').innerHTML = '💥 Game Over! Score: '+score;
        return;
      }
    }

    if(ob.y > H){
      obstacles.splice(i,1);
      score++;
      speed += 0.1;
      document.getElementById('score').innerHTML = '🏆 Score: '+score;
    }
  });

  // Player car
  draw3DCar(playerX, H*0.78, 65, 95, '#FF0000', true);

  requestAnimationFrame(gameLoop);
}
</script>
</body>
</html>
